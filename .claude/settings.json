{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "sh -c 'airev capture --phase pre 2>>.airev/logs/capture-errors.log || true'"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "sh -c 'airev capture --phase post 2>>.airev/logs/capture-errors.log || true'"
          }
        ]
      }
    ]
  }
}
